{
  "info": {"name": "Mock Concord Insurance API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [
    {"key": "baseUrl", "value": "https://api.example.com"},
    {"key": "token", "value": ""}, {"key": "customerId", "value": ""},
    {"key": "vehicleId", "value": ""}, {"key": "quoteId", "value": ""},
    {"key": "offerId", "value": ""}, {"key": "orderId", "value": ""}, {"key": "invoiceId", "value": ""}
  ],
  "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]},
  "item": [
    {"name": "01 - Login", "request": {"auth": {"type": "noauth"}, "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body":{"mode":"raw","raw":"{\"username\":\"DEMO_USER_FROM_SECRET_MANAGER\",\"password\":\"DEMO_PASSWORD_FROM_SECRET_MANAGER\"}"}, "url":"{{baseUrl}}/api/v1/auth/token"}},
    {"name": "02 - Create customer", "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"national_id\":\"1234567890\",\"birth_date\":\"1995-05-18\",\"phone\":\"967777123456\",\"full_name\":\"Mohammed Ahmed\"}"},"url":"{{baseUrl}}/api/v1/customers"}},
    {"name": "03 - Create vehicle", "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"customer_id\":\"{{customerId}}\",\"registration_type\":\"PRIVATE\",\"plate_no\":\"12345\",\"brand\":\"Toyota\",\"model\":\"Prado\",\"year\":2022,\"vehicle_value\":85000}"},"url":"{{baseUrl}}/api/v1/vehicles"}},
    {"name": "04 - Search offers", "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"customer_id\":\"{{customerId}}\",\"vehicle_id\":\"{{vehicleId}}\"}"},"url":"{{baseUrl}}/api/v1/quotes"}},
    {"name": "05 - Select offer", "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"offer_id\":\"{{offerId}}\"}"},"url":"{{baseUrl}}/api/v1/quotes/{{quoteId}}/select"}},
    {"name": "06 - Create order + invoice", "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"postman-order-001"}],"body":{"mode":"raw","raw":"{\"customer_id\":\"{{customerId}}\",\"vehicle_id\":\"{{vehicleId}}\",\"quote_id\":\"{{quoteId}}\",\"offer_id\":\"{{offerId}}\"}"},"url":"{{baseUrl}}/api/v1/orders"}},
    {"name": "07 - Simulate payment success", "request": {"method":"POST","url":"{{baseUrl}}/api/v1/testing/payments/{{invoiceId}}/success"}},
    {"name": "08 - Verify payment", "request": {"method":"GET","url":"{{baseUrl}}/api/v1/invoices/{{invoiceId}}/payment-status"}},
    {"name": "09 - Issue policy", "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"order_id\":\"{{orderId}}\"}"},"url":"{{baseUrl}}/api/v1/policies"}}
  ]
}
