# Production-only Supabase Edge Function secrets.
# Copy to deploy/production/.env on a secure deployment host; never commit it.
APP_ENV=prod
ALLOW_STAGING_DIRECT_AUTH=false
WHATSAPP_OTP_ENABLED=true
ALLOW_PHONE_PASSWORD_SIGNUP=false
ALLOW_STAGING_UNVERIFIED_PHONE_LINKS=false

PHONE_HMAC_KEY=replace-with-random-secret-at-least-32-bytes
PHONE_ENCRYPTION_KEY=replace-with-random-32-byte-base64-key
PHONE_KEY_VERSION=1
WORKER_SECRET=replace-with-random-secret-at-least-32-bytes
ALLOWED_ORIGIN=debtledger://

# Must point to the dedicated production OpenWA gateway over HTTPS.
OPENWA_BASE_URL=https://openwa-api.example.com
OPENWA_SESSION_ID=muthbat-production
OPENWA_API_KEY=replace-with-random-secret-at-least-32-bytes

PUSH_PROVIDER=fcm
FCM_PROJECT_ID=muthbat-6de17
NOTIFICATION_WORKER_SECRET=replace-with-random-secret-at-least-32-bytes
# Server-side service-account JSON on one line; never bundle in the app.
FIREBASE_SERVICE_ACCOUNT=
