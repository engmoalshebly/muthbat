# Copy to .env, fill with staging-only values, and never commit that file.
# SUPABASE_URL/ANON/SERVICE_ROLE are injected by hosted Supabase functions.
APP_ENV=staging
ALLOW_STAGING_DIRECT_AUTH=false

PHONE_HMAC_KEY=replace-with-random-secret-at-least-32-bytes
PHONE_ENCRYPTION_KEY=replace-with-random-32-byte-base64-key
PHONE_KEY_VERSION=1
WORKER_SECRET=replace-with-random-secret-at-least-32-bytes
ALLOWED_ORIGIN=debtledger://

# Must be an HTTPS address reachable from hosted Supabase Edge Functions.
OPENWA_BASE_URL=https://openwa-api.staging.example.com
OPENWA_SESSION_ID=muthbat-staging
OPENWA_API_KEY=replace-with-random-secret-at-least-32-bytes

PUSH_PROVIDER=in_app
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
# FCM_SERVER_KEY=
# FCM_PROJECT_ID=
# FCM_BEARER_TOKEN=
