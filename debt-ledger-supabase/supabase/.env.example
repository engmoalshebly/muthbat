# Supabase Debt Ledger - Environment Variables & Secrets
# Use `supabase secrets set --env-file supabase/.env` for a hosted project.
# Do not commit the real .env file or production secrets to source control.

# Cryptographic Keys (Phone hashing and AES-GCM encryption)
PHONE_HMAC_KEY=replace-with-a-random-32-byte-base64-key
PHONE_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-key
PHONE_KEY_VERSION=1

# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY when functions run through the Supabase runtime.
# Never commit or hardcode the service-role key.

# Cron and Worker Secret for Background Edge Functions
WORKER_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGIN=debtledger://

# OpenWA Local/Cloud WhatsApp Gateway Configuration
OPENWA_BASE_URL=http://127.0.0.1:2785
OPENWA_SESSION_ID=default
OPENWA_API_KEY=

# Push Notification Configuration ('expo' | 'fcm' | 'in_app' | 'mock')
PUSH_PROVIDER=in_app

# Expo Push Endpoint (when PUSH_PROVIDER=expo)
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send

# Firebase Cloud Messaging Configuration (when PUSH_PROVIDER=fcm)
FCM_SERVER_KEY=replace-with-firebase-cloud-messaging-server-key
FCM_PROJECT_ID=replace-with-firebase-project-id
FCM_BEARER_TOKEN=optional-oauth2-bearer-token-for-fcm-v1
