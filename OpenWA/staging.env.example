# Copy to .env on the staging host. Never commit the real file.
NODE_ENV=production
HTTPS_ENABLED=true
ENABLE_SWAGGER=false
DASHBOARD_ENABLED=false
LOG_LEVEL=info
OPENWA_DOMAIN=openwa.203.0.113.10.nip.io
OPENWA_IP=203.0.113.10
API_BIND_IP=127.0.0.1
API_PORT=2785
CORS_ORIGINS=debtledger://
API_MASTER_KEY=replace-with-random-secret-at-least-32-bytes
ENGINE_TYPE=whatsapp-web.js
PUPPETEER_HEADLESS=true
DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=openwa
DATABASE_USERNAME=openwa
DATABASE_PASSWORD=replace-with-random-database-password
DATABASE_SYNCHRONIZE=false
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
STORAGE_TYPE=local
REDIS_ENABLED=false
QUEUE_ENABLED=false
