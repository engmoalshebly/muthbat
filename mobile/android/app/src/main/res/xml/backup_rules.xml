<?xml version="1.0" encoding="utf-8"?>
<!-- Device-bound encryption keys cannot be restored with copied app files.
     Portable notebooks use the app's explicit encrypted export instead. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
